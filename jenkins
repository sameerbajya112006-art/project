pipeline {
    agent any

    tools {
        nodejs 'NodeJS' // Configure a NodeJS installation named "NodeJS" in Jenkins Global Tool Config
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test'
            }
        }
    }

    post {
        always {
            junit 'reports/junit.xml'
        }
        success {
            echo 'All tests passed!'
        }
        failure {
            echo 'Some tests failed. Check the JUnit report.'
        }
    }
}